# Salin menjadi .env, lalu isi nilainya. File .env tidak masuk ke repositori.
# Backend hanya membaca environment, jadi muat dulu file ini ke shell.

# Wajib
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://PROJECT.supabase.co/auth/v1

# Pakai ini kalau proyek Supabase masih memakai secret lama, sebagai ganti SUPABASE_JWKS_URL
# SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Alamat
PORT=8080
# URL publik API, dipakai di isi QR Solana Pay. Produksi wajib HTTPS.
PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
AUTO_MIGRATE=true
# STORE_ICON_URL=http://localhost:3000/icon.png

# Solana, hanya Devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Kurs. FIXED_IDR_PER_SOL adalah cadangan saat CoinGecko tidak bisa dihubungi.
COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=idr
# FIXED_IDR_PER_SOL=2500000
RATE_CACHE_TTL=45s

# Waktu
ORDER_TTL=5m
ORDER_GRACE=2m
REFUND_TTL=5m
WALLET_NONCE_TTL=5m
WORKER_INTERVAL=2s
WORKER_BATCH=50

# Rate limit. Di Render, isi TRUSTED_PROXY_HOPS=1 agar IP asli terbaca.
RATE_LIMIT_ACCOUNT_PER_MINUTE=120
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_ORDER_PER_MINUTE=30
TRUSTED_PROXY_HOPS=0

# Cache
CATALOG_CACHE_TTL=5s
DASHBOARD_CACHE_TTL=30s

# Seed demo, hanya dibaca cmd/seed
SEED_OWNER_EMAIL=pemilik@example.com
# SEED_CASHIER_EMAIL=
# SEED_CONSIGNOR_EMAILS=a@example.com,b@example.com,c@example.com
# SEED_CONSIGNOR_WALLETS=
