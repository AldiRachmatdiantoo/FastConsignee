# Salin menjadi .env, lalu isi nilainya. File .env tidak masuk ke repositori.
PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/fastconsignee
AUTO_MIGRATE=true

# URL publik API, dipakai di isi QR Solana Pay. Produksi wajib HTTPS.
PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
STORE_ICON_URL=

# Isi salah satu: secret HS256, atau JWKS untuk kunci asimetris Supabase.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

SOLANA_RPC_URL=https://api.devnet.solana.com

# Kurs cadangan kalau CoinGecko tidak bisa dihubungi. Kosongkan untuk mematikannya.
FIXED_IDR_PER_SOL=

# Jumlah proxy tepercaya di depan API. Render memakai 1.
TRUSTED_PROXY_HOPS=0
