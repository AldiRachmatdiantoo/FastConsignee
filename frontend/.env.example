# Salin menjadi .env.local. File ini tidak masuk ke repositori.

NEXT_PUBLIC_API_URL=http://localhost:8080

# Kosongkan untuk memakai RPC publik Devnet.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Login Google. Isi dengan Project URL dan publishable key dari proyek Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opsional. Client ID Google yang sama dengan di provider Google Supabase. Kalau diisi, Google kembali langsung
# ke /login di situs ini, jadi layar izin Google menyebut alamat situs ini, bukan alamat proyek Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Login lokal menggantikan Google selama proyek Supabase belum ada.
# Hanya berjalan di `next dev`, dan API produksi tetap menolak tokennya.
NEXT_PUBLIC_LOCAL_LOGIN=true
# Harus sama dengan SUPABASE_JWT_SECRET dan SUPABASE_JWT_ISSUER di backend.
LOCAL_JWT_SECRET=
LOCAL_JWT_ISSUER=fastconsignee-local
